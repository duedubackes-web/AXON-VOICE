# Single private studio. Keep Codespaces ports private.
HOST=127.0.0.1
PORT=3000
# Required (16+ characters) if HOST=0.0.0.0. Set a real secret outside Git.
AXON_STUDIO_PASSWORD=
# Set to the exact HTTPS URL when using a reverse proxy.
AXON_PUBLIC_ORIGIN=
# Optional persistent local volume, default: .data/
AXON_DATA_DIR=

# Optional outbound automation. No delivery occurs without server configuration
# and an explicit approved campaign send in the UI.
AXON_AUTOMATION_WEBHOOK_URL=
AXON_AUTOMATION_ALLOWED_HOSTS=
# At least 32 characters. Used for HMAC SHA-256.
AXON_AUTOMATION_SIGNING_SECRET=
# At least 24 characters. Configure X-Axon-Token Header Auth on the receiver.
AXON_AUTOMATION_TOKEN=

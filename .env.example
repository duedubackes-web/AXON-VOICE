# Single private studio. Keep Codespaces ports private.
HOST=127.0.0.1
PORT=3000
# Required (16+ characters) if HOST=0.0.0.0. Set a real secret outside Git.
AXON_STUDIO_PASSWORD=
# Set to the exact HTTPS URL when using a reverse proxy.
AXON_PUBLIC_ORIGIN=
# Optional persistent local volume, default: .data/
AXON_DATA_DIR=
